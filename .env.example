# TextLink — production environment template
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
APP_URL=https://your-domain.com
# Product brand name (shown in UI + emails)
APP_NAME=TextLink

# sqlite (default) or Postgres: postgresql://user:pass@host:5432/textlink
# DATABASE_URL=postgresql://user:pass@host:5432/textlink

REQUIRE_EMAIL_CONFIRM=true
REQUIRE_CONNECTION_TO_MESSAGE=true
AUTH_TOKEN_TTL_HOURS=48
# CORS_ORIGINS=https://your-domain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# Email (required for confirmation emails in production)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@textlink.app
